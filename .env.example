# Supabase
# The URL and anonymous key are used by browser/session clients.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never expose, log, or use this value in browser code.
SUPABASE_SERVICE_ROLE_KEY=

# GoHighLevel integration
GHL_API_BASE=
GHL_VERSION=
GHL_PRIVATE_TOKEN=
GHL_LOCATION_ID=
GHL_ASSISTANT_WEBHOOK_SECRET=
# Optional; defaults to 7 days of reconciliation history and 180 days ahead.
GHL_MEETING_SYNC_LOOKBACK_DAYS=
GHL_MEETING_SYNC_FUTURE_DAYS=

# Podcast sync
TRANSISTOR_SHOW_ID=
TRANSISTOR_API_KEY=
CRON_SECRET=

# Help requests via Rebel SMTP (server only). Sending stays disabled until complete.
# Dusan supplied this destination; confirm the mailbox is active before launch.
SUPPORT_TO_EMAIL=support@rebootmembers.com
# Plain sender address authorized by the Rebel mailbox/SMTP account.
SUPPORT_FROM_EMAIL=
# Copy exact settings from Rebel; do not infer the SMTP host from MX records.
SUPPORT_SMTP_HOST=
SUPPORT_SMTP_PORT=
# true = implicit TLS (usually 465); false = required STARTTLS (usually 587).
# Set explicitly. false never permits an unencrypted connection.
SUPPORT_SMTP_SECURE=
SUPPORT_SMTP_USER=
SUPPORT_SMTP_PASSWORD=
# At least 32 random characters, used to hash rate-limit identities.
SUPPORT_RATE_LIMIT_SECRET=

# Verified backup email: keep disabled until local Auth/database testing is complete.
# These values are server-only. The primary Supabase email stays unchanged.
BACKUP_EMAIL_ENABLED=false
# Fixed application origin, e.g. https://hub.rebootmembers.com (no path).
BACKUP_EMAIL_ORIGIN=
# At least 32 random characters; separate from the support rate-limit secret.
BACKUP_EMAIL_SECRET=
# smtp uses the SUPPORT_SMTP_* settings and SUPPORT_FROM_EMAIL above.
# local is restricted to a loopback app, Supabase API and SMTP server.
BACKUP_EMAIL_DELIVERY_MODE=smtp
# Only for local Mailpit; tools/backup-email-local.ps1 supplies these.
BACKUP_EMAIL_LOCAL_SMTP_HOST=
BACKUP_EMAIL_LOCAL_SMTP_PORT=
BACKUP_EMAIL_LOCAL_FROM_EMAIL=

# Optional: separate local Next.js output from the default .next directory.
# tools/start-local.ps1 sets this to .next-local for local database testing.
REBOOT_NEXT_DIST_DIR=
